{
  "name": "@board/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage"
  },
  "dependencies": {
    "@board/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/adapter-pg": "~7.5.0",
    "@prisma/client": "~7.5.0",
    "dotenv": "^17.2.0",
    "nodemailer": "10.6.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "jest": "^29.7.0",
    "prisma": "~7.5.0",
    "socket.io-client": "^4.8.0",
    "ts-jest": "^29.4.0",
    "tsc-watch": "^6.3.1",
    "tsx": "^4.20.0"
  }
}
