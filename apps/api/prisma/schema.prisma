generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MemberRole {
  EDITOR
  VIEWER
}

enum ColumnColor {
  GRAY
  RED
  AMBER
  GREEN
  TEAL
  BLUE
  PURPLE
  PINK
}

model Account {
  id         String        @id @default(uuid())
  email      String        @unique
  name       String        @default("")
  avatar     Bytes?
  sessions   Session[]
  boards     Board[]
  memberships BoardMember[]
  assignees  Assignee[]

  @@map("accounts")
}

model Session {
  digest    String   @id
  accountId String   @map("account_id")
  expiresAt DateTime @map("expires_at")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginCode {
  email     String   @id
  digest    String
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("login_codes")
}

model AuthLimit {
  key       String   @id
  attempts  Int
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("auth_limits")
}

model BoardMember {
  boardId   String     @map("board_id")
  accountId String     @map("account_id")
  role      MemberRole
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([boardId, accountId])
  @@index([accountId])
  @@map("board_members")
}

model BoardInvite {
  boardId   String     @map("board_id")
  email     String
  role      MemberRole
  expiresAt DateTime   @map("expires_at")
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([boardId, email])
  @@index([email, expiresAt])
  @@map("board_invites")
}

model Board {
  id        String     @id
  name      String
  revision  Int        @default(0)
  columns   Column[]
  assignees Assignee[]
  creations CardCreation[]
  ownerId   String?        @map("owner_id")
  owner     Account?       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members   BoardMember[]
  invites   BoardInvite[]

  @@index([ownerId])
  @@map("boards")
}

model CardCreation {
  id      String @id @db.Uuid
  boardId String @map("board_id")
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@map("card_creations")
}

model Column {
  id       String @id @default(uuid())
  name     String
  position Int
  color    ColumnColor @default(GRAY)
  boardId  String @map("board_id")
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId, position])
  @@map("columns")
}

model Assignee {
  id       String @id @default(uuid())
  name     String
  initials String
  boardId  String @map("board_id")
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  assignments CardAssignee[]
  accountId   String?        @map("account_id")
  account     Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([boardId])
  @@index([accountId])
  @@unique([boardId, accountId])
  @@map("assignees")
}

model Card {
  id          String    @id @default(uuid())
  title       String
  description String
  priority    Priority
  tags        String[]  @default([])
  position    Float
  version     Int       @default(1)
  columnId    String    @map("column_id")
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignments CardAssignee[]

  @@index([columnId, position])
  @@map("cards")
}

model CardAssignee {
  cardId     String   @map("card_id")
  assigneeId String   @map("assignee_id")
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  assignee   Assignee @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@id([cardId, assigneeId])
  @@index([assigneeId])
  @@map("card_assignees")
}
